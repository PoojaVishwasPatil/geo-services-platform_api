# Application Configuration
PROJECT_NAME="Nearby Services Platform"
ENVIRONMENT="development"
DEBUG=true
API_V1_PREFIX="/api/v1"

# Database Configuration (PostgreSQL + PostGIS)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=nearby_services
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/nearby_services

# Redis Configuration (Caching & Rate Limiting)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
CACHE_DEFAULT_TTL_SECONDS=300

# Rate Limiting Configuration
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PUBLIC_PER_MINUTE=60
RATE_LIMIT_SEARCH_PER_MINUTE=60
RATE_LIMIT_AUTH_PER_MINUTE=5

# Security & JWT Configuration
JWT_SECRET_KEY="super-secret-key-change-in-production-min-32-chars-long"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Default Admin Seed Credentials
ADMIN_DEFAULT_USERNAME="admin"
ADMIN_DEFAULT_EMAIL="admin@nearbyservices.com"
ADMIN_DEFAULT_PASSWORD="AdminPassword123!"

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

